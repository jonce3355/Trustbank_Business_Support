NODE_ENV=production
PORT=3000

# Строка подключения к базе Supabase (Settings -> Database -> Connection string -> Transaction pooler)
DATABASE_URL=

# Токены ботов из @BotFather
CUSTOMER_BOT_TOKEN=
EMPLOYEE_BOT_TOKEN=

# Адрес вашего сайта после деплоя на Vercel, например: https://trustbank-support.vercel.app
WEB_APP_URL=

# Ваш личный Telegram ID (узнать через бота @userinfobot) — станет Супер-администратором
SUPER_ADMIN_TELEGRAM_ID=

# Пороги SLA в минутах
FIRST_RESPONSE_SLA_MINUTES=15
RESOLUTION_SLA_MINUTES=240
